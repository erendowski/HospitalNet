<UserControl x:Class="HospitalNet.UI.Views.DoctorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200"
             Background="{DynamicResource BackgroundBrush}">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="20" Background="Transparent">
            <TextBlock Text="Doctors Management" FontSize="{StaticResource FontSizeXLarge}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
            <TextBlock Text="Add doctors, manage their information, and view appointments" FontSize="{StaticResource FontSizeNormal}" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" Margin="20,0,20,20" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Search:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBox Grid.Column="1" x:Name="SearchTextBox" Height="35" Padding="10,0,10,0" VerticalContentAlignment="Center" Style="{StaticResource StandardTextBoxStyle}" Foreground="{DynamicResource TextPrimaryBrush}" TextChanged="SearchTextBox_TextChanged"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button x:Name="AddDoctorButton" Width="140" Height="35" Style="{StaticResource PrimaryButtonStyle}" Click="AddDoctorButton_Click" Cursor="Hand" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Add Doctor" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="RefreshButton" Width="100" Height="35" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshButton_Click" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content - Split View -->
        <Grid Grid.Row="2" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- Doctors List -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Doctors List" FontSize="{StaticResource FontSizeMedium}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="20,15,20,10"/>

                    <DataGrid Grid.Row="1" x:Name="DoctorsDataGrid" Style="{StaticResource StandardDataGridStyle}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" RowHeight="40" ColumnHeaderHeight="40" SelectionChanged="DoctorsDataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="First" Binding="{Binding FirstName}" Width="100"/>
                            <DataGridTextColumn Header="Last"  Binding="{Binding LastName}"  Width="100"/>
                            <DataGridTextColumn Header="Specialization" Binding="{Binding Specialization}" Width="120" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <DataGridTextColumn Header="License" Binding="{Binding LicenseNumber}" Width="100" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" Width="120" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <DataGridTextColumn Header="Salary" Binding="{Binding Salary, StringFormat=₺{0:N2}}" Width="100" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <DataGridTextColumn Header="Experience" Binding="{Binding YearsOfExperience}" Width="80" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Doctor Details & Appointments Panel -->
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                <ScrollViewer x:Name="DetailsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="15,15,15,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Doctor Details" FontSize="{StaticResource FontSizeMedium}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="EditSelectedDoctorButton" Width="90" Height="32" Style="{StaticResource SecondaryButtonStyle}" Click="EditSelectedDoctorButton_Click" IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0"/>
                                    <TextBlock Text="Edit"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="DeactivateSelectedDoctorButton" Width="120" Height="32" Margin="10,0,0,0" Style="{StaticResource DangerButtonStyle}" Click="DeactivateSelectedDoctorButton_Click" IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0"/>
                                    <TextBlock Text="Delete"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Add Doctor Screen (inline) -->
                    <Border Grid.Row="1" x:Name="AddDoctorPanel" Visibility="Collapsed" Margin="15,0,15,15" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Add Doctor" FontSize="{StaticResource FontSizeMedium}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                            <UniformGrid Columns="2" Rows="5">
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="First Name" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="NewDoctorFirstNameTextBox" Style="{StaticResource StandardTextBoxStyle}" Height="32" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Last Name" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="NewDoctorLastNameTextBox" Style="{StaticResource StandardTextBoxStyle}" Height="32" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="Specialization" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="NewDoctorSpecializationTextBox" Style="{StaticResource StandardTextBoxStyle}" Height="32" Margin="0,6,0,0" Text="General Practice"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="License Number" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="NewDoctorLicenseTextBox" Style="{StaticResource StandardTextBoxStyle}" Height="32" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="Phone" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="NewDoctorPhoneTextBox" Style="{StaticResource StandardTextBoxStyle}" Height="32" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Email" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="NewDoctorEmailTextBox" Style="{StaticResource StandardTextBoxStyle}" Height="32" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="Office" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="NewDoctorOfficeTextBox" Style="{StaticResource StandardTextBoxStyle}" Height="32" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Years of Experience" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="NewDoctorYearsTextBox" Style="{StaticResource StandardTextBoxStyle}" Height="32" Margin="0,6,0,0" Text="0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,10,10,0">
                                    <StackPanel>
                                        <TextBlock Text="Max Patients/Day" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="NewDoctorMaxPatientsTextBox" Style="{StaticResource StandardTextBoxStyle}" Height="32" Margin="0,6,0,0" Text="20"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Active" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                        <CheckBox x:Name="NewDoctorIsActiveCheckBox" IsChecked="True" Content="Yes" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Salary" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="NewDoctorSalaryTextBox" Style="{StaticResource StandardTextBoxStyle}" Height="32" Margin="0,6,0,0" Text="0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Cancel" Width="80" Height="32" Style="{StaticResource SecondaryButtonStyle}" Click="CancelAddDoctor_Click" Cursor="Hand" Margin="10,18,0,0"/>
                                    <Button Grid.Column="2" Content="Save" Width="80" Height="32" Style="{StaticResource PrimaryButtonStyle}" Click="SaveAddDoctor_Click" Cursor="Hand" Margin="10,18,0,0"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Doctor Info Card -->
                    <Border Grid.Row="2" Margin="15,0,15,15" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="15">
                        <StackPanel x:Name="DoctorDetailsPanel">
                            <TextBlock x:Name="DoctorNameTextBlock" Text="Select a doctor" FontSize="{StaticResource FontSizeMedium}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                            <TextBlock x:Name="DoctorSpecTextBlock" Text="" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                            
                            <UniformGrid Columns="2" Rows="3">
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="Email" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="DoctorEmailTextBlock" Text="-" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Phone" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="DoctorPhoneTextBlock" Text="-" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="Office" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="DoctorOfficeTextBlock" Text="-" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Salary" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="DoctorSalaryTextBlock" Text="-" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="Experience" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="DoctorExperienceTextBlock" Text="-" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Max Patients/Day" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="DoctorMaxPatientsTextBlock" Text="-" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Appointments Header -->
                    <Grid Grid.Row="3" Margin="15,0,15,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Appointments" FontSize="{StaticResource FontSizeMedium}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="Date:" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker x:Name="AppointmentsDateFilterPicker" Width="130" Height="28" VerticalAlignment="Center" SelectedDateChanged="AppointmentsDateFilterPicker_SelectedDateChanged"/>
                        </StackPanel>
                    </Grid>

                    <!-- Selected Appointment Details -->
                    <Border Grid.Row="4" Margin="15,0,15,10" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Selected Appointment" FontSize="{StaticResource FontSizeMedium}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                            <TextBlock x:Name="SelectedAppointmentSummaryText" Text="-" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Appointments List -->
                    <DataGrid Grid.Row="5" x:Name="AppointmentsDataGrid" Style="{StaticResource StandardDataGridStyle}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" RowHeight="35" ColumnHeaderHeight="35" Margin="15,0,15,15" SelectionChanged="AppointmentsDataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding AppointmentTime, StringFormat=HH:mm}" Width="60" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="100" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <DataGridTextColumn Header="Reason" Binding="{Binding ReasonForVisit}" Width="*" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Margin="20,0,20,20" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="15,10">
            <TextBlock x:Name="StatusTextBlock" Text="Ready" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}"/>
        </Border>
    </Grid>
</UserControl>
