<Window x:Class="HospitalNet.UI.Dialogs.AddDoctorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add/Edit Doctor"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Width="550"
        Height="700"
        Background="{DynamicResource BackgroundBrush}"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="20" Background="Transparent">
            <TextBlock x:Name="TitleTextBlock" Text="Add New Doctor" FontSize="{StaticResource FontSizeXLarge}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="20,0,20,20" Background="Transparent">
            <StackPanel Orientation="Vertical" Background="Transparent">
                <TextBlock Text="First Name *" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                <TextBox x:Name="FirstNameTextBox" Height="35" Padding="10,0,10,0" VerticalContentAlignment="Center" Style="{StaticResource StandardTextBoxStyle}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,15"/>

                <TextBlock Text="Last Name *" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                <TextBox x:Name="LastNameTextBox" Height="35" Padding="10,0,10,0" VerticalContentAlignment="Center" Style="{StaticResource StandardTextBoxStyle}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,15"/>

                <TextBlock Text="Specialization *" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                <ComboBox x:Name="SpecializationComboBox" Height="35" Margin="0,0,0,15">
                    <ComboBoxItem Content="Cardiology"/>
                    <ComboBoxItem Content="Neurology"/>
                    <ComboBoxItem Content="Orthopedics"/>
                    <ComboBoxItem Content="Pediatrics"/>
                    <ComboBoxItem Content="Dermatology"/>
                    <ComboBoxItem Content="General Practice"/>
                    <ComboBoxItem Content="Psychiatry"/>
                    <ComboBoxItem Content="Surgery"/>
                    <ComboBoxItem Content="Ophthalmology"/>
                    <ComboBoxItem Content="Oncology"/>
                </ComboBox>

                <TextBlock Text="License Number *" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                <TextBox x:Name="LicenseNumberTextBox" Height="35" Padding="10,0,10,0" VerticalContentAlignment="Center" Style="{StaticResource StandardTextBoxStyle}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,15"/>

                <TextBlock Text="Phone *" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                <TextBox x:Name="PhoneTextBox" Height="35" Padding="10,0,10,0" VerticalContentAlignment="Center" Style="{StaticResource StandardTextBoxStyle}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,15"/>

                <TextBlock Text="Email *" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                <TextBox x:Name="EmailTextBox" Height="35" Padding="10,0,10,0" VerticalContentAlignment="Center" Style="{StaticResource StandardTextBoxStyle}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,15"/>

                <TextBlock Text="Office Location *" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                <TextBox x:Name="OfficeLocationTextBox" Height="35" Padding="10,0,10,0" VerticalContentAlignment="Center" Style="{StaticResource StandardTextBoxStyle}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,15"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Years of Experience *" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                        <TextBox x:Name="YearsOfExperienceTextBox" Height="35" Padding="10,0,10,0" VerticalContentAlignment="Center" Style="{StaticResource StandardTextBoxStyle}" Foreground="{DynamicResource TextPrimaryBrush}" Text="0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Max Patients/Day *" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                        <TextBox x:Name="MaxPatientsTextBox" Height="35" Padding="10,0,10,0" VerticalContentAlignment="Center" Style="{StaticResource StandardTextBoxStyle}" Foreground="{DynamicResource TextPrimaryBrush}" Text="20"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Monthly Salary (₺) *" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                <TextBox x:Name="SalaryTextBox" Height="35" Padding="10,0,10,0" VerticalContentAlignment="Center" Style="{StaticResource StandardTextBoxStyle}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,15" Text="0"/>

                <CheckBox x:Name="IsActiveCheckBox" Content="Active" IsChecked="True" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,15"/>

                <TextBlock x:Name="StatusTextBlock" Text="" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20" Background="{DynamicResource SurfaceBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Height="40">
                <Button x:Name="CancelButton" Content="Cancel" Width="100" Height="40" Style="{StaticResource SecondaryButtonStyle}" Click="CancelButton_Click" Cursor="Hand" Margin="0,0,10,0"/>
                <Button x:Name="SaveButton" Content="Save" Width="100" Height="40" Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
